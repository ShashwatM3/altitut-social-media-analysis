# Copy this file to .env and fill in the required values before starting the app.
#
# Required: OPENAI_API_KEY, EXA_API_KEY, APIFY_TOKEN, FIREBASE_PROJECT_ID
# Optional: Telegram bot, Upload-Post auto-post, service-account key

APIFY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
APIFY_ACTOR_ID=apify/instagram-profile-scraper
APIFY_DEFAULT_PLATFORM=instagram

# ---- Auto-post: Upload-Post (primary) ----
UPLOAD_POST_API_KEY=
UPLOAD_POST_BASE_URL=https://api.upload-post.com/api
UPLOAD_POST_PROFILE=altitut

# ---- Auto-post: Post for Me (fallback vendor, optional) ----
POST_FOR_ME_API_KEY=
POST_FOR_ME_BASE_URL=https://api.postforme.dev/v1

# ---- Switch ----
SOCIAL_PROVIDER=upload_post

# Telegram content-pack bot (see README / SETUP_NEEDED_FROM_YOU.md for how to create these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- Firebase ----
FIREBASE_PROJECT_ID=altitut-sma-dashboard
# Leave blank to use Application Default Credentials (gcloud auth / GCP metadata).
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Redis / Celery (used by the FastAPI backend only) ----
REDIS_URL=redis://localhost:6379/0
